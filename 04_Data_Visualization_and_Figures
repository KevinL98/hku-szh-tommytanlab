PlotEnrichmentDot <- function(df, title = "", top_n = 10, wrap_width = 20) {
  
  plot_df <- df %>%
    mutate(
      Count           = as.numeric(Count),
      P_Value         = as.numeric(`P-Value`),
      Fold_Enrichment = as.numeric(`Fold Enrichment`),
      minusLog10P     = -log10(P_Value),
      Term            = str_wrap(Term, width = wrap_width)
    ) %>%
    arrange(P_Value) %>%
    slice_head(n = top_n)
  
  plot_df$Term <- factor(plot_df$Term, levels = rev(plot_df$Term))
  
  p <- ggplot(plot_df, aes(x = minusLog10P, y = Term)) +
    geom_point(aes(size = Count, color = minusLog10P), alpha = 0.92) +
    scale_color_gradient(low = "#D1E5F0", high = "#B2182B", limits = global_color_limits) +
    scale_size_continuous(range = c(1.5, 5.5), limits = global_size_limits) +
    theme_classic(base_size = 10) +
    labs(
      title = title,
      x     = expression(-log[10](italic(P))),
      y     = NULL,
      color = expression(-log[10](italic(P))),
      size  = "Count"
    ) +
    theme(
      plot.title       = element_text(hjust = 0.5, face = "bold", size = 11),
      axis.text.y      = element_text(size = 13, colour = "black", lineheight = 0.72),
      axis.text.x      = element_text(size = 8, colour = "black"),
      axis.title.x     = element_text(face = "bold", size = 9),
      panel.grid       = element_blank(),
      plot.margin      = margin(t = 5, r = 5, b = 5, l = 5),

      legend.position  = "bottom",
      legend.box       = "horizontal",
      legend.title     = element_text(size = 8, face = "bold"),
      legend.text      = element_text(size = 7),
      legend.spacing.x = unit(0.2, "cm")
    ) +
    guides(
      color = guide_colorbar(title.position = "top", title.hjust = 0.5, barwidth = unit(3.2, "cm"), barheight = unit(0.22, "cm")),
      size  = guide_legend(title.position = "top", title.hjust = 0.5, nrow = 1, keywidth = unit(0.35, "cm"))
    )
  
  return(p)
}

