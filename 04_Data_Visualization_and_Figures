PlotLineageScore <- function(seurat_obj, feature_name, main_title, gene_list, split_var = "orig.ident") {

  p <- FeaturePlot(seurat_obj, features = feature_name, split.by = split_var, pt.size = 0.5) & 
    custom_colors & 
    custom_theme

  genes_str <- paste(gene_list, collapse = ", ")
  
  p <- p + plot_annotation(
    title = main_title,
    subtitle = bquote(italic(.(genes_str))), 
    theme = theme(
      plot.title = element_text(size = 20, face = "bold", hjust = 0),
      plot.subtitle = element_text(size = 16, hjust = 0)
    )
  )
  
  return(p)
}

